# AutoAlpha 本地配置模板
#
# 用法：cp .env.example .env，填入你的值。`.env` 已在 .gitignore 中，
# 不会被提交；保存后权限会自动设为 600。
#
# 优先级：进程环境变量 > 项目 .env > ~/.autoalpha/.env
# 也就是说，临时想换模型时直接 export LLM_MODEL=... 即可，不用改文件。

# ── LLM ────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=
# OpenAI 兼容端点（含各类网关）需要显式给出 base_url
LLM_BASE_URL=

# 输出 token 上限。推理模型（DeepSeek v4.x / o-series / thinking 类）的
# 思维链与正文共享这个预算，默认已按模型自动放大到 32768，一般不用改。
# LLM_MAX_TOKENS=32768

# 单价（美元/百万 token）。不填则按模型 ID 推断，仅供量级参考。
# LLM_PRICE_INPUT=0.27
# LLM_PRICE_OUTPUT=1.10

# ── 数据 ───────────────────────────────────────────────────────────────────
# 本地行情目录，CSV 可直接放在该目录或任意子目录
# AUTOALPHA_KLINES=/path/to/klines

# 学术 API 的「礼貌池」联系邮箱，可换来更稳定的速率配额
# AUTOALPHA_CONTACT_EMAIL=you@example.com
